# Example only. Export these variables explicitly; the CLI does not load .env files.
# Token/signing files and state must stay outside source control.
KEYSSO_API_TOKEN_FILE=/run/secrets/keysso-api-token
KEYSSO_STATE_PATH=/state/keysso.sqlite
KEYSSO_ACCOUNT_ID=default
KEYSSO_LOCAL_PRINCIPAL=local-operator
KEYSSO_RATE_LIMIT=10
KEYSSO_PRINCIPAL_RATE_LIMIT=10
KEYSSO_MAX_CONCURRENCY=1

# Required for HTTP; stdio uses the local operator identity.
KEYSSO_MCP_PUBLIC_KEY_FILE=/run/secrets/keysso-issuer-public.pem
KEYSSO_MCP_ISSUER=zai-mcp-platform
KEYSSO_MCP_AUDIENCE=keysso-mcp
KEYSSO_AUTH_MODE=delegated

# Update check: at startup and on keysso_check_update the server asks api.github.com
# (anonymous, at most once a day) for the latest release. It only suggests a command.
# Set to 1 to disable all of it, e.g. on HTTP/server deployments without outbound access.
KEYSSO_DISABLE_UPDATE_CHECK=0
